rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only touch their own four documents. Everything else is closed.
    match /users/{uid}/data/{name} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
                          && name in ['posts', 'notes', 'letter', 'days', 'future'];
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && name in ['posts', 'notes', 'letter', 'days', 'future']
                            && request.resource.data.keys().hasOnly(['v', 't'])
                            && request.resource.data.v is string
                            && request.resource.data.v.size() < 900000
                            && request.resource.data.t is number;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
